    "docx": "9.1.1",
    "jszip": "3.10.1",
    "mammoth": "1.9.0",
    "pdf-lib": "1.17.1",
    "react": "18.3.1",
    "react-native": "0.77.3",
    "react-native-document-scanner-plugin": "2.0.4",
    "react-native-gesture-handler": "2.23.1",
    "react-native-google-mobile-ads": "14.7.2",
