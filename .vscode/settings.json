{
  // Use the TypeScript in node_modules (5.6.3) rather than the one bundled with the
  // editor. They disagree about how a "types" entry resolves, which showed up as an
  // error on tsconfig.json in the editor while `npx tsc --noEmit` passed cleanly.
  "typescript.tsdk": "node_modules/typescript/lib",
  "typescript.enablePromptUseWorkspaceTsdk": true
}
