<?xml version="1.0" encoding="utf-8"?>
<!--
    The artwork carries its own transparency, so it is used the way an adaptive
    icon is meant to be used: it is the foreground, and @color/icon_bg fills in
    behind it. Where the launcher's mask cuts the rounded corners away it is the
    background colour that shows, which is why that colour is sampled from the
    artwork's own edge rather than picked by eye.

    The picture's subject sits well inside the middle of the canvas, so a round,
    squircle or teardrop mask takes only the blue surround and never the
    documents or the arrows.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/icon_bg" />
    <foreground android:drawable="@drawable/ic_launcher_art" />
    <monochrome android:drawable="@drawable/ic_launcher_monochrome" />
</adaptive-icon>
