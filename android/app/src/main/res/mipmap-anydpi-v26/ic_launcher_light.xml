<?xml version="1.0" encoding="utf-8"?>
<!--
    The icon shown while the phone is in light mode (LauncherIcon.kt swaps the two).
    The artwork is a full square on a near-white ground, so it is drawn at 72dp in
    the middle of the 108dp layer, which is exactly the part any launcher mask shows,
    and @color/icon_bg_light, sampled from the artwork's edge, fills the rest.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/icon_bg_light" />
    <foreground android:drawable="@drawable/ic_launcher_light_art" />
    <monochrome android:drawable="@drawable/ic_launcher_monochrome" />
</adaptive-icon>
